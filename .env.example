# NewsKarnataka Project - Environment Configuration Example
# Copy this file to .env and fill in appropriate values
# This file is for reference - do NOT commit actual credentials

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=103.191.208.235
DB_PORT=5432
DB_USER=news
DB_PASSWORD=news321
DB_NAME=newskarnataka
DB_SSL=true
DB_SSL_MODE=require

# Database Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# ============================================
# STRAPI CONFIGURATION
# ============================================
STRAPI_PORT=1337
STRAPI_HOST=0.0.0.0
NODE_ENV=production
ADMIN_JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_SECRET=your-jwt-secret-key-change-in-production
API_TOKEN_SALT=your-api-token-salt-change-in-production

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=NewsKarnataka
APP_URL=https://newskarnataka.com
ADMIN_URL=https://admin.newskarnataka.com
API_URL=https://api.newskarnataka.com

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d
SESSION_SECRET=your-session-secret-key
CORS_ORIGIN=https://newskarnataka.com,https://admin.newskarnataka.com
CORS_CREDENTIALS=true

# ============================================
# AI/ML INTEGRATION (Groq)
# ============================================
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=mixtral-8x7b-32768
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048
AI_VALIDATION_ENABLED=true
AI_AUTO_APPROVE_THRESHOLD=0.85

# ============================================
# EXTERNAL SERVICES
# ============================================
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=newskarnataka-media
AWS_S3_URL=https://newskarnataka-media.s3.amazonaws.com

# Redis
REDIS_HOST=redis.newskarnataka.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch.newskarnataka.com
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PROTOCOL=https
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@newskarnataka.com
EMAIL_FROM_NAME=NewsKarnataka

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=your-sentry-dsn-url
DATADOG_API_KEY=your-datadog-api-key

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_VALIDATION=true
FEATURE_BULK_OPERATIONS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_CUSTOM_WORKFLOWS=false
FEATURE_API_ACCESS=false

# ============================================
# CACHING
# ============================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_STRATEGY=redis

# ============================================
# DATA RETENTION
# ============================================
AUDIT_LOG_RETENTION_DAYS=2555
ACTIVITY_LOG_RETENTION_DAYS=365
BACKUP_RETENTION_DAYS=30

# ============================================
# DEVELOPMENT/DEBUGGING
# ============================================
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_CORS=true
ALLOW_ORIGIN_LOCALHOST=false


